PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/incidentops
ESCALATION_TIMEOUT_MINUTES=5

# Optional - if unset, alerts are logged to console only (safe demo mode)
SMTP_USER=
SMTP_PASS=

# AWS - Lambda endpoint URL (from API Gateway after deploying aws/snsAlertLambda.js)
# See aws/README.md for full setup instructions.
AWS_LAMBDA_ALERT_URL=
AWS_REGION=ap-south-1
AWS_SNS_TOPIC_ARN=

# IBM Cloudant (audit log mirror — see backend/src/integrations/cloudantAudit.js)
# Create a free-tier Cloudant instance at cloud.ibm.com and get the service URL + API key.
IBM_CLOUDANT_URL=
IBM_CLOUDANT_APIKEY=
